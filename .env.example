# ──────────────────────────────────────────────────────────────
# Supabase Connection
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Strongly recommended for speed: lets the app verify login sessions locally
# instead of calling Supabase Auth on every page click.
# Supabase Dashboard → Project Settings → JWT Keys → "Legacy JWT Secret".
# (Not needed if the project uses the new asymmetric JWT signing keys.)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ──────────────────────────────────────────────────────────────
# Database URLs (PostgreSQL / Supabase / Neon)
# ──────────────────────────────────────────────────────────────
# Transaction mode pooler (port 6543) with PgBouncer.
# Serverless: keep connection_limit small per function instance (many instances
# run in parallel); the pooler multiplexes them. Keep Vercel's function region
# (vercel.json "regions") in the same region as this database (ap-south-1 ⇄ bom1).
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&pool_timeout=20&connect_timeout=10"

# Direct / Session mode (port 5432) for migrations
DIRECT_DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────────────────────
# Secrets
# ──────────────────────────────────────────────────────────────
# QR code JWT signing secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
QR_JWT_SECRET=your-random-64-byte-hex-string

# Vercel Cron authentication secret (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=your-cron-secret-key

# Optional: password for development seed accounts (random if unset). Never seed production.
# SEED_DEFAULT_PASSWORD=
