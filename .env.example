# ──────────────────────────────────────────────────────────────
# Supabase Connection
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ──────────────────────────────────────────────────────────────
# Database URLs (PostgreSQL / Supabase / Neon)
# ──────────────────────────────────────────────────────────────
# Transaction mode pooler (port 6543) with PgBouncer
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=10&connect_timeout=10"

# Direct / Session mode (port 5432) for migrations
DIRECT_DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ──────────────────────────────────────────────────────────────
# Secrets
# ──────────────────────────────────────────────────────────────
# QR code JWT signing secret (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
QR_JWT_SECRET=your-random-64-byte-hex-string

# Vercel Cron authentication secret
CRON_SECRET=your-cron-secret-key
