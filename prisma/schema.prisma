generator client {
  provider        = "prisma-client-js"
  // relationJoins: related rows come back in ONE query (joins) instead of a
  // chain of queries, one per relation
  previewFeatures = ["fullTextSearch", "fullTextIndex", "relationJoins"]
  // native = local dev; rhel-openssl-3.0.x = Vercel (Amazon Linux 2023). Only ship what is used.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  // Connection pooling optimization for high concurrency
  // Supabase pgBouncer transaction mode recommended for serverless
}

model Profile {
  id            String         @id @default(uuid())
  userId        String         @unique
  role          Role
  name          String
  email         String         @unique
  phone         String?
  /// Job title for Admin, Warden, Security and Supervisor accounts (faculty,
  /// HODs, Deans and Directors keep theirs on the faculty record). Shown under
  /// "Gate Pass" in the app frame.
  designation   String?
  active        Boolean        @default(true)
  /// When the profile photo was last set (null = no photo). The photo lives in
  /// Storage at avatars/<id>.jpg; this date versions its URL so browsers cache it.
  avatarUpdatedAt DateTime?    @map("avatar_updated_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  faculty       Faculty?
  securityStaff SecurityStaff?
  student       Student?
  warden        Warden?
  /// Security register records this person created (immutable)
  registerEntries   RegisterEntry[]
  /// Visitors this person registered at the gate
  recordedOutsiders Outsider[]     @relation("OutsiderRecordedBy")
  /// Visitors / admission people who came to meet this person (meeting codes)
  hostedVisits      VisitPass[]    @relation("VisitPassHost")
  /// Self check-in requests (QR at the gate) from visitors who came to meet this person
  hostedVisitRequests VisitRequest[] @relation("VisitRequestHost")
  /// Self check-in requests made from this guard's Show QR screen
  issuedVisitRequests VisitRequest[] @relation("VisitRequestIssuedBy")

  @@index([role, active])
  @@map("profiles")
}

model Student {
  id          String                @id @default(uuid())
  profileId   String                @unique @map("profile_id")
  studentRoll String                @unique @map("student_roll")
  department  String?
  year        Int?
  semester    Int?
  section     String?
  studentType StudentType           @default(DAY_SCHOLAR) @map("student_type")
  /// Boys / Ladies hostel (hostellers only)
  hostelType  HostelType?           @map("hostel_type")
  facultyId   String?               @map("faculty_id")
  wardenId    String?               @map("warden_id")
  roomNumber  String?               @map("room_number")
  hostelBlock String?               @map("hostel_block")
  status      StudentMovementStatus @default(INSIDE)
  /// Parents / guardian: fill the Visitors Book form when they come to the gate
  /// (src/lib/students/parents.ts). New students need one parent and the address.
  fatherName       String? @map("father_name")
  fatherPhone      String? @map("father_phone")
  motherName       String? @map("mother_name")
  motherPhone      String? @map("mother_phone")
  guardianName     String? @map("guardian_name")
  guardianRelation String? @map("guardian_relation")
  guardianPhone    String? @map("guardian_phone")
  homeAddress      String? @map("home_address")
  /// The family's usual vehicle (Security confirms it at each visit)
  parentVehicle    String? @map("parent_vehicle")
  createdAt   DateTime              @default(now()) @map("created_at")
  movements   Movement[]
  permissions Permission[]
  faculty     Faculty?              @relation("AssignedStudents", fields: [facultyId], references: [id])
  profile     Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  warden      Warden?               @relation("AssignedHostellers", fields: [wardenId], references: [id])

  @@index([facultyId])
  @@index([wardenId])
  @@index([department])
  @@index([status])
  @@index([studentType])
  @@map("students")
}

model Faculty {
  id                  String               @id @default(uuid())
  profileId           String               @unique @map("profile_id")
  employeeId          String?              @unique @map("employee_id")
  department          String?
  designation         String?
  maxApprovals        Int                  @default(5) @map("max_approvals")
  createdAt           DateTime             @default(now()) @map("created_at")
  profile             Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permissionApprovals PermissionApproval[]
  assignedStudents    Student[]            @relation("AssignedStudents")
  permissions         Permission[]         @relation("FacultyPermissions")
  movements           Movement[]           @relation("FacultyMovements")

  @@index([department])
  @@map("faculty")
}

model Warden {
  id                  String               @id @default(uuid())
  profileId           String               @unique @map("profile_id")
  employeeId          String?              @unique @map("employee_id")
  hostelBlock         String?              @map("hostel_block")
  createdAt           DateTime             @default(now()) @map("created_at")
  permissionApprovals PermissionApproval[]
  assignedHostellers  Student[]            @relation("AssignedHostellers")
  profile             Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("wardens")
}

model SecurityStaff {
  id         String     @id @default(uuid())
  profileId  String     @unique @map("profile_id")
  employeeId String?    @unique @map("employee_id")
  /// Head Security: everything a guard can do, plus taking staff attendance
  isHead     Boolean    @default(false) @map("is_head")
  gateId     String?    @map("gate_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  movements  Movement[]
  gate       Gate?      @relation(fields: [gateId], references: [id])
  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("security_staff")
}

model Permission {
  id              String              @id @default(uuid())
  studentId       String?             @map("student_id")
  facultyId       String?             @map("faculty_id")
  type            MovementType        @default(EXIT) // EXIT or ENTRY
  approverType    ApproverType        @map("approver_type")
  approverId      String              @map("approver_id")
  status          PermissionStatus    @default(PENDING)
  purpose         String
  destination     String?
  exitDate        DateTime            @map("exit_date")
  expectedExit    DateTime?           @map("expected_exit")
  expectedReturn  DateTime?           @map("expected_return")
  remarks         String?
  contactNumber   String?             @map("contact_number")
  rejectionReason String?             @map("rejection_reason")
  approvedAt      DateTime?           @map("approved_at")
  rejectedAt      DateTime?           @map("rejected_at")
  cancelledAt     DateTime?           @map("cancelled_at")
  /// "SINGLE" = one approver decides; "BOTH" = faculty pass needing HOD AND Dean approval
  approvalMode    String              @default("SINGLE") @map("approval_mode")
  hodApprovedAt   DateTime?           @map("hod_approved_at")
  hodApproverId   String?             @map("hod_approver_id")
  deanApprovedAt  DateTime?           @map("dean_approved_at")
  deanApproverId  String?             @map("dean_approver_id")
  /// Faculty Book (Form 1): ONE_HOUR | HALF_DAY_CL | FULL_DAY_CL | MULTI_DAY_CL | OD
  requestType     String?             @map("request_type")
  /// Last day of the permission / outing (exitDate is the first day)
  endDate         DateTime?           @map("end_date")
  numberOfDays    Float?              @map("number_of_days")
  /// Hostel outing pass (Forms 12/13): parent/guardian communication
  parentInformed        Boolean?      @map("parent_informed")
  videoCallNumber       String?       @map("video_call_number")
  guardianName          String?       @map("guardian_name")
  guardianRelation      String?       @map("guardian_relation")
  hostelInchargeDetails String?       @map("hostel_incharge_details")
  /// Snapshot of the warden at request time
  wardenDetails         String?       @map("warden_details")
  /// "HOSTEL" = hosteller going from college to the hostel: HOD approves,
  /// the hostel warden scans the QR (not gate security). Null = normal pass.
  passKind              String?       @map("pass_kind")
  /// Hostel pass: when / which warden scanned the student in at the hostel
  wardenScannedAt       DateTime?     @map("warden_scanned_at")
  wardenScannedById     String?       @map("warden_scanned_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  movements       Movement[]
  approval        PermissionApproval?
  student         Student?            @relation(fields: [studentId], references: [id])
  faculty         Faculty?            @relation("FacultyPermissions", fields: [facultyId], references: [id])
  qr              QrCredential?

  @@index([studentId, createdAt(sort: Desc)])
  @@index([facultyId, createdAt(sort: Desc)])
  @@index([approverId, status])
  @@index([approverType, status])
  @@index([status, exitDate])
  @@index([exitDate])
  @@index([endDate])
  @@index([createdAt(sort: Desc)])
  // "Approved / rejected today" counts use the partial indexes idx_permissions_approved_at /
  // idx_permissions_rejected_at (prisma/migrations/add_performance_indexes.sql); db push keeps them.
  @@map("permissions")
}

model PermissionApproval {
  id           String       @id @default(uuid())
  permissionId String       @unique @map("permission_id")
  approverType ApproverType @map("approver_type")
  facultyId    String?      @map("faculty_id")
  wardenId     String?      @map("warden_id")
  approved     Boolean
  reason       String?
  createdAt    DateTime     @default(now()) @map("created_at")
  faculty      Faculty?     @relation(fields: [facultyId], references: [id])
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  warden       Warden?      @relation(fields: [wardenId], references: [id])

  @@index([facultyId, createdAt(sort: Desc)])
  @@index([wardenId, createdAt(sort: Desc)])
  @@map("permission_approvals")
}

model QrCredential {
  id           String     @id @default(uuid())
  permissionId String     @unique @map("permission_id")
  token        String     @unique
  expiresAt    DateTime   @map("expires_at")
  active       Boolean    @default(true)
  usedForExit  Boolean    @default(false) @map("used_for_exit")
  usedForEntry Boolean    @default(false) @map("used_for_entry")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("qr_credentials")
}

model Gate {
  id            String          @id @default(uuid())
  name          String          @unique
  location      String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now()) @map("created_at")
  movements     Movement[]
  securityStaff SecurityStaff[]

  @@map("gates")
}

model Movement {
  id             String        @id @default(uuid())
  permissionId   String        @map("permission_id")
  studentId      String?       @map("student_id")
  facultyId      String?       @map("faculty_id")
  gateId         String        @map("gate_id")
  securityUserId String        @map("security_user_id")
  type           MovementType
  imagePath      String?       @map("image_path")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  gate           Gate          @relation(fields: [gateId], references: [id])
  permission     Permission    @relation(fields: [permissionId], references: [id])
  securityUser   SecurityStaff @relation(fields: [securityUserId], references: [id])
  student        Student?      @relation(fields: [studentId], references: [id])
  faculty        Faculty?      @relation("FacultyMovements", fields: [facultyId], references: [id])

  @@index([studentId, createdAt(sort: Desc)])
  @@index([facultyId, createdAt(sort: Desc)])
  @@index([securityUserId, createdAt(sort: Desc)])
  @@index([gateId, createdAt(sort: Desc)])
  // One EXIT and one ENTRY per pass at most: a double scan can never record twice
  @@unique([permissionId, type])
  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("movements")
}

model Outsider {
  id              String    @id @default(uuid())
  name            String
  phone           String
  category        String    @default("GUEST")
  purpose         String
  visitingStudent String?   @map("visiting_student")
  gate            String?
  vehicleNumber   String?   @map("vehicle_number")
  photoUrl        String?   @map("photo_url")
  status          String    @default("INSIDE")
  entryTime       DateTime  @default(now()) @map("entry_time")
  exitTime        DateTime? @map("exit_time")
  /// Visitors Book (Form 2)
  address         String?
  department      String?
  remarks         String?
  /// Guard who registered the visitor (snapshot kept for history)
  recordedById    String?   @map("recorded_by_id")
  recordedBy      Profile?  @relation("OutsiderRecordedBy", fields: [recordedById], references: [id])
  recordedByName  String?   @map("recorded_by_name")
  createdAt       DateTime  @default(now()) @map("created_at")
  /// Meeting code, when the visitor came to meet a faculty / staff member
  visitPass       VisitPass?
  /// The self check-in request (QR at the gate) this visitor was let in from
  visitRequest    VisitRequest?

  @@index([status, entryTime(sort: Desc)])
  @@index([entryTime(sort: Desc)])
  @@index([exitTime(sort: Desc)])
  @@map("outsiders")
}

/// One immutable record in a Security register (Forms 3–11, 14, 15, 17–19).
/// Never updated or deleted (enforced by database triggers): a later return
/// time is a COMPLETION record and a fix is a CORRECTION record, each pointing
/// at the ORIGINAL through parentId.
/// A register created in the portal (by Main Admin or Head Security) instead of in code.
/// Its entries are ordinary RegisterEntry rows whose `register` is this `key`.
model CustomRegister {
  id            String   @id @default(uuid())
  /// Stored on entries, e.g. "CUSTOM_7K2F9Q"
  key           String   @unique
  /// URL part, e.g. "custom-7k2f9q"
  slug          String   @unique
  title         String
  description   String   @default("")
  /// The form: [{ key, label, type, options? }] (see src/lib/registers/custom.ts)
  fields        Json
  /// Keys of fields that must be filled in
  required      String[] @default([])
  /// In & Out register: a record starts with In or Out; the other side is recorded later
  hasInOut      Boolean  @default(false) @map("has_in_out")
  /// Disabled registers are hidden everywhere (their records are kept)
  active        Boolean  @default(true)
  createdById   String   @map("created_by_id")
  createdByName String   @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([active, createdAt])
  @@map("custom_registers")
}

model RegisterEntry {
  id                   String          @id @default(uuid())
  /// Register key, e.g. "CAR_BOOK" (see src/lib/registers/definitions.ts)
  register             String
  /// ORIGINAL | COMPLETION | CORRECTION
  kind                 String          @default("ORIGINAL")
  parentId             String?         @map("parent_id")
  parent               RegisterEntry?  @relation("RegisterSupplements", fields: [parentId], references: [id])
  supplements          RegisterEntry[] @relation("RegisterSupplements")
  /// IST day the record belongs to (the register's Date field, or the day recorded)
  entryDate            DateTime        @map("entry_date")
  data                 Json
  /// Lower-cased text of the main fields, for search
  searchText           String          @default("") @map("search_text")
  /// Why a correction was made
  reason               String?
  recordedById         String          @map("recorded_by_id")
  recordedBy           Profile         @relation(fields: [recordedById], references: [id])
  recordedByName       String          @map("recorded_by_name")
  recordedByRole       String          @map("recorded_by_role")
  recordedByEmployeeId String?         @map("recorded_by_employee_id")
  recordedAtGate       String?         @map("recorded_at_gate")
  /// Generated by the form; makes double submissions harmless
  clientToken          String          @unique @map("client_token")
  createdAt            DateTime        @default(now()) @map("created_at")
  /// Meeting code (e.g. Admission Book: the person came to meet a faculty member)
  visitPass            VisitPass?
  /// The self check-in request (QR at the gate) this record was made from
  visitRequest         VisitRequest?

  @@index([register, kind, entryDate(sort: Desc)])
  @@index([parentId])
  @@index([recordedById, createdAt(sort: Desc)])
  @@map("register_entries")
}

enum HostelType {
  BOYS
  LADIES
}

enum Role {
  ADMIN
  STUDENT
  FACULTY
  FACULTY_ADMIN
  WARDEN
  SECURITY
  DIRECTOR
  DEAN
  /// View-only oversight of student and faculty passes and details
  SECURITY_SUPERVISOR
}

enum StudentType {
  DAY_SCHOLAR
  HOSTELLER
}

enum StudentMovementStatus {
  INSIDE
  OUTSIDE
}

enum ApproverType {
  FACULTY
  WARDEN
  FACULTY_ADMIN
  DIRECTOR
  DEAN
}

enum PermissionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  EXITED
  COMPLETED
}

enum MovementType {
  EXIT
  ENTRY
}

/// Meeting code for a visitor / admission person who came to meet a faculty or
/// staff member. Made when Security records the entry; shown to that person
/// (portal, later email), who tells the visitor after the meeting. Security
/// marks the exit only with this code — or Head Security / Main Admin let them
/// out with a written reason.
model VisitPass {
  id              String         @id @default(uuid())
  /// Visitors Book visitor, or a register record (e.g. Admission Book)
  outsiderId      String?        @unique @map("outsider_id")
  outsider        Outsider?      @relation(fields: [outsiderId], references: [id], onDelete: Cascade)
  registerEntryId String?        @unique @map("register_entry_id")
  registerEntry   RegisterEntry? @relation(fields: [registerEntryId], references: [id], onDelete: Cascade)
  /// Register key for register records (e.g. "ADMISSION"), else "VISITORS"
  register        String
  /// The faculty / staff member being met
  hostProfileId   String         @map("host_profile_id")
  host            Profile        @relation("VisitPassHost", fields: [hostProfileId], references: [id], onDelete: Cascade)
  hostName        String         @map("host_name")
  visitorName     String         @map("visitor_name")
  visitorPhone    String?        @map("visitor_phone")
  purpose         String?
  /// 4 digits; never shown to Security
  code            String
  /// INSIDE -> MET (host pressed "Meeting done", optional) -> EXITED
  status          String         @default("INSIDE")
  /// Wrong codes tried at the gate; locked at 5
  attempts        Int            @default(0)
  metAt           DateTime?      @map("met_at")
  exitedAt        DateTime?      @map("exited_at")
  /// CODE | OVERRIDE
  exitMethod      String?        @map("exit_method")
  overrideReason  String?        @map("override_reason")
  exitedByName    String?        @map("exited_by_name")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([hostProfileId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("visit_passes")
}

/// Self check-in from a visitor's own phone (Visitors Book / Admission Book).
/// The visitor scans the QR on Security's screen and fills the form; Security
/// checks it, takes the photo and accepts it (-> a normal Visitors Book visitor
/// or Admission Book record, linked here) or rejects it. The phone follows the
/// visit with a secret only it has (kept here only as a SHA-256 hash).
/// PENDING -> ACCEPTED -> EXITED, or REJECTED. A PENDING request older than 60
/// minutes counts as expired. See src/lib/visits/requests.ts.
model VisitRequest {
  id               String         @id @default(uuid())
  /// "VISITORS" | "ADMISSION"
  register         String
  /// PENDING | ACCEPTED | REJECTED | EXITED
  status           String         @default("PENDING")
  /// SHA-256 (hex) of the phone's secret; the secret itself is never stored
  secretHash       String         @unique @map("secret_hash")
  /// What the visitor typed (keys = the register's field keys)
  data             Json
  visitorName      String         @map("visitor_name")
  visitorPhone     String         @map("visitor_phone")
  /// Faculty / staff member they came to meet (exit with the meeting code)
  hostProfileId    String?        @map("host_profile_id")
  host             Profile?       @relation("VisitRequestHost", fields: [hostProfileId], references: [id], onDelete: SetNull)
  /// Office they came to (exit by scanning the office's QR poster)
  officeId         String?        @map("office_id")
  office           Office?        @relation(fields: [officeId], references: [id], onDelete: SetNull)
  /// Guard whose QR was scanned, and that guard's gate at the time
  issuedById       String?        @map("issued_by_id")
  issuedBy         Profile?       @relation("VisitRequestIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  gate             String?
  /// Photo Security took at Accept (storage path, outsiders/...)
  photoUrl         String?        @map("photo_url")
  rejectReason     String?        @map("reject_reason")
  decidedById      String?        @map("decided_by_id")
  decidedByName    String?        @map("decided_by_name")
  decidedAt        DateTime?      @map("decided_at")
  /// The record made at Accept: a Visitors Book visitor or an Admission Book record
  outsiderId       String?        @unique @map("outsider_id")
  outsider         Outsider?      @relation(fields: [outsiderId], references: [id], onDelete: SetNull)
  registerEntryId  String?        @unique @map("register_entry_id")
  registerEntry    RegisterEntry? @relation(fields: [registerEntryId], references: [id], onDelete: SetNull)
  /// From this time the phone shows its Exit QR: CODE (meeting code typed) | OFFICE (office poster scanned)
  exitUnlockedAt   DateTime?      @map("exit_unlocked_at")
  exitUnlockMethod String?        @map("exit_unlock_method")
  officeVisitedAt  DateTime?      @map("office_visited_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([register, status, createdAt(sort: Desc)])
  @@map("visit_requests")
}

/// An office visitors come to (Accounts, Exam cell…). Offices have no logins:
/// each has a printed QR poster (<site>/o/<posterKey>) the visitor scans with
/// their phone to record the visit and unlock their Exit QR.
model Office {
  id        String         @id @default(uuid())
  name      String
  /// Random, unguessable key printed in the poster's QR
  posterKey String         @unique @map("poster_key")
  active    Boolean        @default(true)
  createdAt DateTime       @default(now()) @map("created_at")
  requests  VisitRequest[]

  @@map("offices")
}
