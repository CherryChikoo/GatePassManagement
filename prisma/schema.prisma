generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
  // native = local dev; rhel-openssl-3.0.x = Vercel (Amazon Linux 2023). Only ship what is used.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  // Connection pooling optimization for high concurrency
  // Supabase pgBouncer transaction mode recommended for serverless
}

model Profile {
  id            String         @id @default(uuid())
  userId        String         @unique
  role          Role
  name          String
  email         String         @unique
  phone         String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  faculty       Faculty?
  securityStaff SecurityStaff?
  student       Student?
  warden        Warden?
  /// Security register records this person created (immutable)
  registerEntries   RegisterEntry[]
  /// Visitors this person registered at the gate
  recordedOutsiders Outsider[]     @relation("OutsiderRecordedBy")

  @@index([role, active])
  @@map("profiles")
}

model Student {
  id          String                @id @default(uuid())
  profileId   String                @unique @map("profile_id")
  studentRoll String                @unique @map("student_roll")
  department  String?
  year        Int?
  semester    Int?
  section     String?
  studentType StudentType           @default(DAY_SCHOLAR) @map("student_type")
  /// Boys / Ladies hostel (hostellers only)
  hostelType  HostelType?           @map("hostel_type")
  facultyId   String?               @map("faculty_id")
  wardenId    String?               @map("warden_id")
  roomNumber  String?               @map("room_number")
  hostelBlock String?               @map("hostel_block")
  status      StudentMovementStatus @default(INSIDE)
  createdAt   DateTime              @default(now()) @map("created_at")
  movements   Movement[]
  permissions Permission[]
  faculty     Faculty?              @relation("AssignedStudents", fields: [facultyId], references: [id])
  profile     Profile               @relation(fields: [profileId], references: [id], onDelete: Cascade)
  warden      Warden?               @relation("AssignedHostellers", fields: [wardenId], references: [id])

  @@index([facultyId])
  @@index([wardenId])
  @@index([department])
  @@index([status])
  @@index([studentType])
  @@map("students")
}

model Faculty {
  id                  String               @id @default(uuid())
  profileId           String               @unique @map("profile_id")
  employeeId          String?              @unique @map("employee_id")
  department          String?
  designation         String?
  maxApprovals        Int                  @default(5) @map("max_approvals")
  createdAt           DateTime             @default(now()) @map("created_at")
  profile             Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)
  permissionApprovals PermissionApproval[]
  assignedStudents    Student[]            @relation("AssignedStudents")
  permissions         Permission[]         @relation("FacultyPermissions")
  movements           Movement[]           @relation("FacultyMovements")

  @@index([department])
  @@map("faculty")
}

model Warden {
  id                  String               @id @default(uuid())
  profileId           String               @unique @map("profile_id")
  employeeId          String?              @unique @map("employee_id")
  hostelBlock         String?              @map("hostel_block")
  createdAt           DateTime             @default(now()) @map("created_at")
  permissionApprovals PermissionApproval[]
  assignedHostellers  Student[]            @relation("AssignedHostellers")
  profile             Profile              @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("wardens")
}

model SecurityStaff {
  id         String     @id @default(uuid())
  profileId  String     @unique @map("profile_id")
  employeeId String?    @unique @map("employee_id")
  /// Head Security: everything a guard can do, plus taking staff attendance
  isHead     Boolean    @default(false) @map("is_head")
  gateId     String?    @map("gate_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  movements  Movement[]
  gate       Gate?      @relation(fields: [gateId], references: [id])
  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("security_staff")
}

model Permission {
  id              String              @id @default(uuid())
  studentId       String?             @map("student_id")
  facultyId       String?             @map("faculty_id")
  type            MovementType        @default(EXIT) // EXIT or ENTRY
  approverType    ApproverType        @map("approver_type")
  approverId      String              @map("approver_id")
  status          PermissionStatus    @default(PENDING)
  purpose         String
  destination     String?
  exitDate        DateTime            @map("exit_date")
  expectedExit    DateTime?           @map("expected_exit")
  expectedReturn  DateTime?           @map("expected_return")
  remarks         String?
  contactNumber   String?             @map("contact_number")
  rejectionReason String?             @map("rejection_reason")
  approvedAt      DateTime?           @map("approved_at")
  rejectedAt      DateTime?           @map("rejected_at")
  cancelledAt     DateTime?           @map("cancelled_at")
  /// "SINGLE" = one approver decides; "BOTH" = faculty pass needing HOD AND Dean approval
  approvalMode    String              @default("SINGLE") @map("approval_mode")
  hodApprovedAt   DateTime?           @map("hod_approved_at")
  hodApproverId   String?             @map("hod_approver_id")
  deanApprovedAt  DateTime?           @map("dean_approved_at")
  deanApproverId  String?             @map("dean_approver_id")
  /// Faculty Book (Form 1): ONE_HOUR | HALF_DAY_CL | FULL_DAY_CL | MULTI_DAY_CL | OD
  requestType     String?             @map("request_type")
  /// Last day of the permission / outing (exitDate is the first day)
  endDate         DateTime?           @map("end_date")
  numberOfDays    Float?              @map("number_of_days")
  /// Hostel outing pass (Forms 12/13): parent/guardian communication
  parentInformed        Boolean?      @map("parent_informed")
  videoCallNumber       String?       @map("video_call_number")
  guardianName          String?       @map("guardian_name")
  guardianRelation      String?       @map("guardian_relation")
  hostelInchargeDetails String?       @map("hostel_incharge_details")
  /// Snapshot of the warden at request time
  wardenDetails         String?       @map("warden_details")
  /// "HOSTEL" = hosteller going from college to the hostel: HOD approves,
  /// the hostel warden scans the QR (not gate security). Null = normal pass.
  passKind              String?       @map("pass_kind")
  /// Hostel pass: when / which warden scanned the student in at the hostel
  wardenScannedAt       DateTime?     @map("warden_scanned_at")
  wardenScannedById     String?       @map("warden_scanned_by_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  movements       Movement[]
  approval        PermissionApproval?
  student         Student?            @relation(fields: [studentId], references: [id])
  faculty         Faculty?            @relation("FacultyPermissions", fields: [facultyId], references: [id])
  qr              QrCredential?

  @@index([studentId, createdAt(sort: Desc)])
  @@index([facultyId, createdAt(sort: Desc)])
  @@index([approverId, status])
  @@index([approverType, status])
  @@index([status, exitDate])
  @@index([status])
  @@index([exitDate])
  @@index([createdAt(sort: Desc)])
  @@map("permissions")
}

model PermissionApproval {
  id           String       @id @default(uuid())
  permissionId String       @unique @map("permission_id")
  approverType ApproverType @map("approver_type")
  facultyId    String?      @map("faculty_id")
  wardenId     String?      @map("warden_id")
  approved     Boolean
  reason       String?
  createdAt    DateTime     @default(now()) @map("created_at")
  faculty      Faculty?     @relation(fields: [facultyId], references: [id])
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  warden       Warden?      @relation(fields: [wardenId], references: [id])

  @@index([facultyId, createdAt(sort: Desc)])
  @@index([wardenId, createdAt(sort: Desc)])
  @@map("permission_approvals")
}

model QrCredential {
  id           String     @id @default(uuid())
  permissionId String     @unique @map("permission_id")
  token        String     @unique
  expiresAt    DateTime   @map("expires_at")
  active       Boolean    @default(true)
  usedForExit  Boolean    @default(false) @map("used_for_exit")
  usedForEntry Boolean    @default(false) @map("used_for_entry")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
  @@map("qr_credentials")
}

model Gate {
  id            String          @id @default(uuid())
  name          String          @unique
  location      String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now()) @map("created_at")
  movements     Movement[]
  securityStaff SecurityStaff[]

  @@map("gates")
}

model Movement {
  id             String        @id @default(uuid())
  permissionId   String        @map("permission_id")
  studentId      String?       @map("student_id")
  facultyId      String?       @map("faculty_id")
  gateId         String        @map("gate_id")
  securityUserId String        @map("security_user_id")
  type           MovementType
  imagePath      String?       @map("image_path")
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  gate           Gate          @relation(fields: [gateId], references: [id])
  permission     Permission    @relation(fields: [permissionId], references: [id])
  securityUser   SecurityStaff @relation(fields: [securityUserId], references: [id])
  student        Student?      @relation(fields: [studentId], references: [id])
  faculty        Faculty?      @relation("FacultyMovements", fields: [facultyId], references: [id])

  @@index([studentId, createdAt(sort: Desc)])
  @@index([facultyId, createdAt(sort: Desc)])
  @@index([securityUserId, createdAt(sort: Desc)])
  @@index([gateId, createdAt(sort: Desc)])
  @@index([permissionId])
  @@index([type, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("movements")
}

model Outsider {
  id              String    @id @default(uuid())
  name            String
  phone           String
  category        String    @default("GUEST")
  purpose         String
  visitingStudent String?   @map("visiting_student")
  gate            String?
  vehicleNumber   String?   @map("vehicle_number")
  photoUrl        String?   @map("photo_url")
  status          String    @default("INSIDE")
  entryTime       DateTime  @default(now()) @map("entry_time")
  exitTime        DateTime? @map("exit_time")
  /// Visitors Book (Form 2)
  address         String?
  department      String?
  remarks         String?
  /// Guard who registered the visitor (snapshot kept for history)
  recordedById    String?   @map("recorded_by_id")
  recordedBy      Profile?  @relation("OutsiderRecordedBy", fields: [recordedById], references: [id])
  recordedByName  String?   @map("recorded_by_name")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status, entryTime(sort: Desc)])
  @@index([entryTime(sort: Desc)])
  @@index([exitTime(sort: Desc)])
  @@map("outsiders")
}

/// One immutable record in a Security register (Forms 3–11, 14, 15, 17–19).
/// Never updated or deleted (enforced by database triggers): a later return
/// time is a COMPLETION record and a fix is a CORRECTION record, each pointing
/// at the ORIGINAL through parentId.
model RegisterEntry {
  id                   String          @id @default(uuid())
  /// Register key, e.g. "CAR_BOOK" (see src/lib/registers/definitions.ts)
  register             String
  /// ORIGINAL | COMPLETION | CORRECTION
  kind                 String          @default("ORIGINAL")
  parentId             String?         @map("parent_id")
  parent               RegisterEntry?  @relation("RegisterSupplements", fields: [parentId], references: [id])
  supplements          RegisterEntry[] @relation("RegisterSupplements")
  /// IST day the record belongs to (the register's Date field, or the day recorded)
  entryDate            DateTime        @map("entry_date")
  data                 Json
  /// Lower-cased text of the main fields, for search
  searchText           String          @default("") @map("search_text")
  /// Why a correction was made
  reason               String?
  recordedById         String          @map("recorded_by_id")
  recordedBy           Profile         @relation(fields: [recordedById], references: [id])
  recordedByName       String          @map("recorded_by_name")
  recordedByRole       String          @map("recorded_by_role")
  recordedByEmployeeId String?         @map("recorded_by_employee_id")
  recordedAtGate       String?         @map("recorded_at_gate")
  /// Generated by the form; makes double submissions harmless
  clientToken          String          @unique @map("client_token")
  createdAt            DateTime        @default(now()) @map("created_at")

  @@index([register, kind, entryDate(sort: Desc)])
  @@index([parentId])
  @@index([recordedById, createdAt(sort: Desc)])
  @@map("register_entries")
}

enum HostelType {
  BOYS
  LADIES
}

enum Role {
  ADMIN
  STUDENT
  FACULTY
  FACULTY_ADMIN
  WARDEN
  SECURITY
  DIRECTOR
  DEAN
  /// View-only oversight of student and faculty passes and details
  SECURITY_SUPERVISOR
}

enum StudentType {
  DAY_SCHOLAR
  HOSTELLER
}

enum StudentMovementStatus {
  INSIDE
  OUTSIDE
}

enum ApproverType {
  FACULTY
  WARDEN
  FACULTY_ADMIN
  DIRECTOR
  DEAN
}

enum PermissionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  EXITED
  COMPLETED
}

enum MovementType {
  EXIT
  ENTRY
}
